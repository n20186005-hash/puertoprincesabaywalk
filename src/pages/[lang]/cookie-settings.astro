---
import { languagesList, ui } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import LegalPage from '../../components/LegalPage.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const messages = ui[lang];
---

<BaseLayout lang={lang} title={messages.legal?.cookie?.title}>
  <Header lang={lang} />
  <main id="main-content">
    <LegalPage lang={lang} messages={messages} kind="cookie" />
  </main>
  <Footer lang={lang} />
</BaseLayout>
