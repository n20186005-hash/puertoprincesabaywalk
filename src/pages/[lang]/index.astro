---
import { languagesList, ui } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Introduction from '../../components/Introduction.astro';
import InfoCards from '../../components/InfoCards.astro';
import BestTime from '../../components/BestTime.astro';
import TicketFees from '../../components/TicketFees.astro';
import ParkingInfo from '../../components/ParkingInfo.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import NearbyFood from '../../components/NearbyFood.astro';
import TransportSection from '../../components/TransportSection.astro';
import MapSection from '../../components/MapSection.astro';
import NearbyAttractions from '../../components/NearbyAttractions.astro';
import ItineraryChecklist from '../../components/ItineraryChecklist.astro';
import FAQ from '../../components/FAQ.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = ui[lang] || ui['en'];

// Keyword-driven titles aligned with actual Search Console queries
// (palawan baywalk, baywalk park puerto princesa, *restaurant*, *food*, sunset).
// Keep under ~60 chars so Google doesn't truncate the brand + key intent.
const seoTitle = lang === 'fil'
  ? 'Puerto Princesa Baywalk Park: Seafood, Sunset & Gabay'
  : lang === 'zh'
  ? '普林塞萨港海湾步道公园：海鲜、日落与游玩攻略'
  : 'Puerto Princesa Baywalk Park: Seafood, Sunset & Guide';

const seoDesc = lang === 'fil'
  ? 'Planuhin ang iyong bisita sa Puerto Princesa Baywalk Park sa Palawan — oras ng pagbukas, mga seafood restaurant, sunset views, at libreng gawain sa gabi. Kumpletong gabay.'
  : lang === 'zh'
  ? '规划巴拉望普林塞萨港海湾步道公园之行——开放时间、热门海鲜餐厅、绝美日落与免费夜间活动，完整游玩攻略。'
  : 'Plan your visit to Puerto Princesa Baywalk Park in Palawan — opening hours, top seafood restaurants, sunset views, and free evening activities. Your complete guide.';
---

<BaseLayout lang={lang} title={seoTitle} description={seoDesc}>
  <Header lang={lang} />
  <main id="main-content">
    <Hero lang={lang} />
    <Introduction lang={lang} />
    <InfoCards lang={lang} />
    <BestTime lang={lang} />
    <TicketFees lang={lang} />
    <ParkingInfo lang={lang} />
    <PhotoGallery lang={lang} />
    <MapSection lang={lang} />
    <NearbyFood lang={lang} />
    <TransportSection lang={lang} />
    <NearbyAttractions lang={lang} />
    <ItineraryChecklist lang={lang} />
    <FAQ lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
