---
import { languagesList, ui } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Introduction from '../../components/Introduction.astro';
import InfoCards from '../../components/InfoCards.astro';
import BestTime from '../../components/BestTime.astro';
import TicketFees from '../../components/TicketFees.astro';
import ParkingInfo from '../../components/ParkingInfo.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import NearbyFood from '../../components/NearbyFood.astro';
import TransportSection from '../../components/TransportSection.astro';
import MapSection from '../../components/MapSection.astro';
import Tides from '../../components/Tides.astro';
import WeatherWidget from '../../components/WeatherWidget.astro';
import Heritage from '../../components/Heritage.astro';
import Facilities from '../../components/Facilities.astro';
import Routes from '../../components/Routes.astro';
import Seasonal from '../../components/Seasonal.astro';
import Responsibility from '../../components/Responsibility.astro';
import NearbyAttractions from '../../components/NearbyAttractions.astro';
import ItineraryChecklist from '../../components/ItineraryChecklist.astro';
import FAQ from '../../components/FAQ.astro';
import TopicLinks from '../../components/TopicLinks.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = ui[lang] || ui['en'];

// Match real search intent: free entry, Sulu Sea sunset, seafood & live music,
// opening hours, how to get there, and the best sunset photo spots.
const seoTitle = lang === 'fil'
  ? 'Puerto Princesa City Baywalk Park: Gabay, Sunset at mga Restawran'
  : lang === 'zh'
  ? '普林塞萨港海湾步道公园：免费日落、海鲜餐厅与游玩攻略'
  : 'Puerto Princesa City Baywalk Park: Complete Guide, Sunset & Restaurants';

const seoDesc = lang === 'fil'
  ? 'Libreng pasok, nakamamanghang sunset sa Sulu Sea, sariwang seafood at live music — kumpletong gabay sa Puerto Princesa City Baywalk Park: oras, paano pumunta, mga restawran, at pinakamagandang spot para sa sunset photos.'
  : lang === 'zh'
  ? '免费入园、绝美苏禄海日落、新鲜海鲜与现场音乐——普林塞萨港海湾步道公园完整游玩攻略：开放时间、交通方式、餐厅推荐与最佳日落拍照点。'
  : 'Free entry, stunning Sulu Sea sunsets, fresh seafood & live music — Puerto Princesa City Baywalk Park’s complete visitor guide: hours, how to get there, restaurants, and the best sunset photo spots.';
---

<BaseLayout lang={lang} title={seoTitle} description={seoDesc}>
  <Header lang={lang} />
  <main id="main-content">
    <Hero lang={lang} />
    <Introduction lang={lang} />
    <InfoCards lang={lang} />
    <BestTime lang={lang} />
    <WeatherWidget lang={lang} />
    <TicketFees lang={lang} />
    <ParkingInfo lang={lang} />
    <PhotoGallery lang={lang} />
    <MapSection lang={lang} />
    <Tides lang={lang} />
    <Heritage lang={lang} />
    <NearbyFood lang={lang} />
    <Facilities lang={lang} />
    <TransportSection lang={lang} />
    <Routes lang={lang} />
    <Seasonal lang={lang} />
    <NearbyAttractions lang={lang} />
    <ItineraryChecklist lang={lang} />
    <Responsibility lang={lang} />
    <FAQ lang={lang} />
    <TopicLinks lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
