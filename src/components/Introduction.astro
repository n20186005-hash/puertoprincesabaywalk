---
import { ui } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = ui[lang] || ui['en'];
const i = t.intro;

const highlights = [
  { icon: 'sunset', title: i.highlights?.[0]?.title || 'Sunset Views', desc: i.highlights?.[0]?.desc || '' },
  { icon: 'food', title: i.highlights?.[1]?.title || 'Food Paradise', desc: i.highlights?.[1]?.desc || '' },
  { icon: 'music', title: i.highlights?.[2]?.title || 'Live Music', desc: i.highlights?.[2]?.desc || '' },
  { icon: 'heart', title: i.highlights?.[3]?.title || 'Free Entry', desc: i.highlights?.[3]?.desc || '' },
];
---

<section id="about" class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
    <!-- Text -->
    <div>
      <p class="section-eyebrow mb-3">{i.eyebrow}</p>
      <h2 class="font-display font-bold text-3xl sm:text-4xl text-navy mb-6">
        {i.title}
      </h2>
      <div class="w-20 h-1 bg-sunset rounded-full mb-6"></div>
      <div class="space-y-4 text-navy/80 leading-relaxed">
        {i.paragraphs?.map((p: string) => (
          <p set:html={p} />
        ))}
      </div>
    </div>

    <!-- Highlights Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {highlights.map(item => (
        <div class="glass-card rounded-2xl p-5 hover:shadow-lg transition-shadow">
          <div class="w-10 h-10 bg-sunset/10 rounded-xl flex items-center justify-center mb-3">
            <Icon name={item.icon} size={20} class="text-sunset" />
          </div>
          <h3 class="font-display font-semibold text-navy mb-1">{item.title}</h3>
          <p class="text-sm text-navy/60">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
