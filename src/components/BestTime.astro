---
import { ui } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = ui[lang] || ui['en'];
const b = t.bestTime;

const periods = [
  { key: 'late', icon: 'sunset', badgeColor: 'palm', accentColor: 'gold', ring: false },
  { key: 'peak', icon: 'sunset', badgeColor: 'sunset', accentColor: 'sunset', ring: true },
  { key: 'evening', icon: 'users', badgeColor: 'navy', accentColor: 'navy', ring: false },
];
---

<section id="best-time" class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center mb-14">
    <p class="section-eyebrow mb-3">{b.eyebrow}</p>
    <h2 class="font-display font-bold text-3xl sm:text-4xl text-navy mb-4">
      {b.title}
    </h2>
    <div class="w-20 h-1 bg-sunset rounded-full mx-auto mb-4"></div>
    <p class="text-navy/60 max-w-2xl mx-auto">{b.subtitle}</p>
  </div>

  <!-- Three Time Periods -->
  <div class="grid md:grid-cols-3 gap-6 mb-12">
    {periods.map((period) => {
      const pd = b.periods?.[period.key];
      if (!pd) return null;
      return (
        <div class={`bg-white rounded-2xl p-6 shadow-sm border border-sand-warm/50 ${period.ring ? 'relative ring-2 ring-sunset/20 border-sunset/30' : ''}`}>
          {period.ring && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-sunset text-white text-xs font-bold px-3 py-1 rounded-full">
              {b.periods?.peak?.bestLabel || 'BEST TIME'}
            </div>
          )}
          <div class={`w-12 h-12 rounded-full flex items-center justify-center mb-4 ${period.ring ? 'bg-sunset/10' : period.key === 'late' ? 'bg-gold/10' : 'bg-navy/10'}`}>
            <Icon name={period.icon} size={24} class={period.key === 'late' ? 'text-gold' : period.key === 'peak' ? 'text-sunset' : 'text-navy'} />
          </div>
          <h3 class="font-display font-semibold text-navy text-lg mb-2">{pd.title}</h3>
          <p class={`text-3xl font-display font-bold mb-3 ${period.key === 'late' ? 'text-gold' : period.key === 'peak' ? 'text-sunset' : 'text-navy'}`}>{pd.time}</p>
          <p class="text-navy/60 text-sm leading-relaxed">{pd.desc}</p>
          {pd.badge && (
            <div class="mt-4 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full" class:list={[`bg-${period.badgeColor}/10`]}>
              <span class={`w-2 h-2 rounded-full`} class:list={[`bg-${period.badgeColor}`]}></span>
              <span class={`text-xs font-medium`} class:list={[`text-${period.badgeColor}`]}>{pd.badge}</span>
            </div>
          )}
        </div>
      );
    })}
  </div>

  <!-- Duration Tips -->
  <div class="grid md:grid-cols-2 gap-6">
    <div class="bg-navy text-white rounded-2xl p-6 sm:p-8">
      <h3 class="font-display font-semibold text-xl mb-3 flex items-center gap-2">
        <Icon name="clock" size={22} class="text-gold-light" />
        {b.durationTitle}
      </h3>
      <p class="text-3xl font-display font-bold text-gold-light mb-3">{b.duration}</p>
      <p class="text-white/70 leading-relaxed text-sm">{b.durationDesc}</p>
    </div>
    <div class="bg-ocean/5 rounded-2xl p-6 sm:p-8 border border-ocean/10">
      <h3 class="font-display font-semibold text-xl text-navy mb-3 flex items-center gap-2">
        <Icon name="leaf" size={22} class="text-palm" />
        {b.tipsTitle}
      </h3>
      <ul class="space-y-3 text-navy/70 text-sm leading-relaxed">
        {b.tips?.map((tip: string) => (
          <li class="flex items-start gap-2">
            <span class="text-palm mt-0.5 shrink-0">&#10003;</span>
            <span set:html={tip} />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
