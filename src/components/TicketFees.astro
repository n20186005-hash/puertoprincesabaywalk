---
import Icon from './Icon.astro';
---

<section id="tickets" class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-sand-warm/30">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-14">
      <p class="section-eyebrow mb-3">Admission</p>
      <h2 class="font-display font-bold text-3xl sm:text-4xl text-navy mb-4">
        Tickets &amp; Fees
      </h2>
      <div class="w-20 h-1 bg-sunset rounded-full mx-auto mb-4"></div>
      <p class="text-navy/60 max-w-2xl mx-auto">
        One of the best things about the Baywalk — it's completely free.
      </p>
    </div>

    <!-- Main Free Card -->
    <div class="max-w-3xl mx-auto">
      <div class="bg-white rounded-3xl shadow-lg overflow-hidden border border-palm/10">
        <div class="bg-gradient-to-r from-palm to-palm-light p-6 sm:p-8 text-center">
          <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <Icon name="ticket" size={32} class="text-white" />
          </div>
          <p class="text-4xl sm:text-5xl font-display font-extrabold text-white">FREE</p>
          <p class="text-white/80 mt-2 font-medium">No Entrance Fee</p>
          <p class="text-white/60 text-sm mt-1">The Baywalk is a public space open to everyone</p>
        </div>

        <div class="p-6 sm:p-8">
          <h3 class="font-display font-semibold text-xl text-navy mb-6">What's Included &amp; Optional Costs</h3>

          <div class="grid sm:grid-cols-2 gap-6">
            <!-- Free -->
            <div>
              <h4 class="font-semibold text-palm text-sm uppercase tracking-wider mb-4">Included (Free)</h4>
              <ul class="space-y-3">
                {[
                  'Access to the entire promenade',
                  'Sunset viewing areas & benches',
                  'Public restrooms',
                  'Photo opportunities',
                  'People-watching & ambiance',
                  'Occasional free live music',
                ].map(item => (
                  <li class="flex items-start gap-2.5 text-navy/70 text-sm">
                    <span class="text-palm mt-0.5 shrink-0">&#10003;</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Optional Paid -->
            <div>
              <h4 class="font-semibold text-sunset text-sm uppercase tracking-wider mb-4">At Your Own Cost</h4>
              <ul class="space-y-3">
                {[
                  { item: 'Food & drinks from stalls', price: 'PHP 50–300' },
                  { item: 'Bicycle rental', price: 'PHP 50–100/hr' },
                  { item: 'Souvenir shopping', price: 'PHP 50–500' },
                  { item: 'Tricycle fare to/from', price: 'PHP 50–100' },
                  { item: 'Ice cream & desserts', price: 'PHP 20–80' },
                  { item: 'BBQ seafood platter', price: 'PHP 150–400' },
                ].map(({ item, price }) => (
                  <li class="flex items-start justify-between gap-2 text-sm">
                    <span class="text-navy/70">{item}</span>
                    <span class="text-sunset font-semibold shrink-0">{price}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
