---
import { ui } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = ui[lang] || ui['en'];
const n = t.nearby;

const nearbyAttractions = lang === 'fil' ? [
  { name: 'Immaculate Conception Cathedral', distance: '320 m', type: 'Historical · Religious Site', description: 'Isang magandang asul-at-puting Katolikong katedral na itinayo noong 1961, kilala sa angular na modernong arkitektura nito. Isang mapayapang landmark sa puso ng Puerto Princesa.', icon: 'shield' },
  { name: 'Plaza Cuartel', distance: '370 m', type: 'Historical · Memorial', description: 'Isang na-restore na garrison mula sa panahon ng Espanyol na ginawang memorial park, na may makabagbag-damdaming kasaysayan mula sa World War II. Ngayon ay isang tahimik na hardin na may tanawin ng bay.', icon: 'globe' },
  { name: 'Palawan Museum', distance: '660 m', type: 'Cultural · Museum', description: 'Isang maliit ngunit impormatibong museo na nagpapakita ng mga katutubong kultura, fossil, at artifacts ng Tabon Cave ng Palawan — dapat puntahan ng mga history buff.', icon: 'info' },
  { name: 'Puerto Princesa Underground River', distance: '~80 km', type: 'UNESCO World Heritage · Nature', description: 'Isa sa New 7 Wonders of Nature — isang subterranean river na dumadaloy sa isang nakamamanghang cave system. Kailangan ng day trip mula sa lungsod.', icon: 'water' },
  { name: 'Honda Bay', distance: '~12 km', type: 'Nature · Island Hopping', description: 'Isang magandang bay para sa island-hopping tours — lumangoy, mag-snorkel, at mag-relax sa mga pristine island tulad ng Starfish Island, Cowrie Island, at Luli Island.', icon: 'compass' },
  { name: "Baker's Hill", distance: '~4 km', type: 'Food · Family Attraction', description: 'Isang hilltop bakery at garden park na sikat sa hopia (Filipino pastry) at malalawak na tanawin. Masayang hintuan para sa mga pamilya at pasalubong shopping.', icon: 'leaf' },
] : lang === 'zh' ? [
  { name: '圣母无原罪主教座堂', distance: '320 m', type: '历史 · 宗教场所', description: '建于1961年的美丽蓝白色天主教主教座堂，以其棱角分明的现代建筑闻名。位于普林塞萨港市中心的一个宁静地标。', icon: 'shield' },
  { name: 'Plaza Cuartel', distance: '370 m', type: '历史 · 纪念地', description: '一座修复后的西班牙殖民时期要塞改建的纪念公园，承载着二战时期的辛酸历史。如今是一座可以欣赏海湾景色的静谧花园。', icon: 'globe' },
  { name: '巴拉望博物馆', distance: '660 m', type: '文化 · 博物馆', description: '一座小而信息丰富的博物馆，展示巴拉望的原住民文化、化石和塔本洞穴文物——历史爱好者的必访之地。', icon: 'info' },
  { name: '普林塞萨港地下河', distance: '~80 km', type: 'UNESCO世界遗产 · 自然', description: '世界新七大自然奇观之一——一条流经壮丽洞穴系统的地下河流。需从市区出发进行一日游。', icon: 'water' },
  { name: '本田湾', distance: '~12 km', type: '自然 · 跳岛游', description: '一个适合跳岛游览的美丽海湾——在星鱼岛、Cowrie岛和Luli岛等原始岛屿上游泳、浮潜和放松。', icon: 'compass' },
  { name: '贝克山', distance: '~4 km', type: '美食 · 家庭景点', description: '山顶上的面包房和花园公园，以hopia（菲律宾糕点）和全景视野闻名。适合家庭游玩和购买伴手礼的有趣地点。', icon: 'leaf' },
] : [
  { name: 'Immaculate Conception Cathedral', distance: '320 m', type: 'Historical · Religious Site', description: 'A beautiful blue-and-white Catholic cathedral built in 1961, known for its angular modern architecture. A peaceful landmark in the heart of Puerto Princesa.', icon: 'shield' },
  { name: 'Plaza Cuartel', distance: '370 m', type: 'Historical · Memorial', description: 'A restored Spanish-era garrison turned memorial park, with a poignant history from World War II. Today it\'s a tranquil garden with bay views.', icon: 'globe' },
  { name: 'Palawan Museum', distance: '660 m', type: 'Cultural · Museum', description: 'A small but informative museum showcasing Palawan\'s indigenous cultures, fossils, and the Tabon Cave artifacts — a must for history buffs.', icon: 'info' },
  { name: 'Puerto Princesa Underground River', distance: '~80 km', type: 'UNESCO World Heritage · Nature', description: 'One of the New 7 Wonders of Nature — a subterranean river flowing through a stunning cave system. Requires a day trip from the city.', icon: 'water' },
  { name: 'Honda Bay', distance: '~12 km', type: 'Nature · Island Hopping', description: 'A beautiful bay for island-hopping tours — swim, snorkel, and relax on pristine islands like Starfish Island, Cowrie Island, and Luli Island.', icon: 'compass' },
  { name: "Baker's Hill", distance: '~4 km', type: 'Food · Family Attraction', description: 'A hilltop bakery and garden park famous for hopia (Filipino pastry) and panoramic views. Fun stop for families and pasalubong shopping.', icon: 'leaf' },
];

const fromText = lang === 'fil' ? 'mula sa Baywalk' : lang === 'zh' ? '距海湾步道' : 'from Baywalk';
const sectionEyebrow = lang === 'fil' ? 'Tuklasin ang Palibot' : lang === 'zh' ? '探索周边' : 'Explore More';
const sectionTitle = n?.title || (lang === 'fil' ? 'Mga Kalapit na Atraksyon' : lang === 'zh' ? '附近景点' : 'Nearby Attractions');
const sectionDesc = lang === 'fil' ? 'Ang Baywalk ay napapaligiran ng pinakamahusay na landmark at natural wonders ng Puerto Princesa.' : lang === 'zh' ? '海湾步道周围环绕着普林塞萨港最著名的地标和自然奇观。' : "The Baywalk is surrounded by Puerto Princesa's best landmarks and natural wonders.";
---

<section id="nearby" class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center mb-14">
    <p class="section-eyebrow mb-3">{sectionEyebrow}</p>
    <h2 class="font-display font-bold text-3xl sm:text-4xl text-navy mb-4">
      {sectionTitle}
    </h2>
    <div class="w-20 h-1 bg-sunset rounded-full mx-auto mb-4"></div>
    <p class="text-navy/60 max-w-2xl mx-auto">{sectionDesc}</p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {nearbyAttractions.map(attr => (
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-sand-warm/40 hover:shadow-md transition-shadow">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 bg-ocean/10 rounded-xl flex items-center justify-center shrink-0">
            <Icon name={attr.icon} size={20} class="text-ocean" />
          </div>
          <div>
            <h3 class="font-display font-semibold text-navy">{attr.name}</h3>
            <p class="text-xs text-ocean font-medium">{attr.type}</p>
          </div>
        </div>
        <p class="text-navy/60 text-sm leading-relaxed mb-3">{attr.description}</p>
        <div class="flex items-center gap-2">
          <span class="bg-sunset/10 text-sunset text-xs font-semibold px-2.5 py-1 rounded-full flex items-center gap-1">
            <Icon name="pin" size={12} />
            {attr.distance} {fromText}
          </span>
        </div>
      </div>
    ))}
  </div>
</section>
