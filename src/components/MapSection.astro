---
import { ui } from '../i18n/ui';
import { mapsUrl } from '../config';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = ui[lang] || ui['en'];
const m = t.map;
---

<!-- Map Embed -->
<section id="map" class="relative" aria-label={lang === 'fil' ? 'Lokasyon sa Google Maps' : lang === 'zh' ? 'Google 地图位置' : 'Google Maps location'}>
  <div class="w-full" style="aspect-ratio: 16/9; min-height: 400px;">
    <iframe
      title={lang === 'fil' ? 'Puerto Princesa City Baywalk Park sa Google Maps' : lang === 'zh' ? '普林塞萨港海湾步道公园 · Google 地图' : 'Puerto Princesa City Baywalk Park on Google Maps'}
      src="https://www.google.com/maps?q=9.7445,118.7365&output=embed"
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="block"
    ></iframe>
  </div>

  <!-- Overlay Info -->
  <div class="absolute bottom-4 left-4 sm:left-8 z-10">
    <div class="glass-card rounded-xl p-3 sm:p-4 max-w-xs">
      <p class="text-xs text-navy/50 uppercase tracking-wider font-semibold mb-1">
        {m?.location || (lang === 'fil' ? 'Lokasyon' : lang === 'zh' ? '位置' : 'Location')}
      </p>
      <p class="text-sm font-semibold text-navy">Sandoval St, Puerto Princesa City</p>
      <div class="flex items-center gap-1.5 mt-2">
        <Icon name="pin" size={14} class="text-sunset" />
        <span class="text-xs text-navy/60">JGHF+3QC</span>
      </div>
      <a
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 mt-2 text-xs text-ocean hover:text-ocean-deep font-medium transition-colors"
      >
        {t.common.maps}
        <Icon name="arrow" size={12} />
      </a>
    </div>
  </div>
</section>
