---
import { ui } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = ui[lang] || ui['en'];
const f = t.food;

// Generic street-food dishes (categories, not vendors) — kept neutral.
const streetFood = lang === 'fil' ? [
  { item: 'Inihaw na Pusit', price: 'PHP 50–100', desc: 'Bagong ihaw, pinalamanan ng sibuyas at kamatis' },
  { item: 'Fish Balls at Kikiam', price: 'PHP 20–50', desc: 'Klasikong Pinoy street snacks na may matamis at maanghang na sarsa' },
  { item: 'Isaw (Bituka ng Manok)', price: 'PHP 15–30', desc: 'Inihaw sa skewer, paborito ng lokal' },
  { item: 'BBQ Pork Skewers', price: 'PHP 20–40', desc: 'Minarinado at inihaw nang perpekto' },
  { item: 'Halo-Halo', price: 'PHP 50–80', desc: 'Shaved ice dessert na may iba\'t ibang toppings' },
  { item: 'Sariwang Katas ng Buko', price: 'PHP 30–50', desc: 'Ihinahain diretso mula sa bao' },
] : lang === 'zh' ? [
  { item: '烤鱿鱼 (Pusit)', price: 'PHP 50–100', desc: '新鲜烤制，填入洋葱和番茄' },
  { item: '鱼丸与 Kikiam', price: 'PHP 20–50', desc: '经典菲律宾街头小吃，甜辣酱调味' },
  { item: 'Isaw (烤鸡肠)', price: 'PHP 15–30', desc: '串烤，本地人的最爱' },
  { item: '烤猪肉串', price: 'PHP 20–40', desc: '腌制后火焰烤至完美' },
  { item: 'Halo-Halo', price: 'PHP 50–80', desc: '菲律宾经典刨冰甜点' },
  { item: '鲜椰子水', price: 'PHP 30–50', desc: '直接从椰壳中享用' },
] : [
  { item: 'Grilled Squid (Pusit)', price: 'PHP 50–100', desc: 'Freshly grilled, stuffed with onions & tomatoes' },
  { item: 'Fish Balls & Kikiam', price: 'PHP 20–50', desc: 'Classic Filipino street snacks with sweet & spicy sauce' },
  { item: 'Isaw (Chicken Intestines)', price: 'PHP 15–30', desc: 'Grilled on skewers, a local favorite' },
  { item: 'BBQ Pork Skewers', price: 'PHP 20–40', desc: 'Marinated and flame-grilled to perfection' },
  { item: 'Halo-Halo', price: 'PHP 50–80', desc: 'Shaved ice dessert with mixed toppings' },
  { item: 'Fresh Coconut Juice', price: 'PHP 30–50', desc: 'Served straight from the shell' },
];

const categories = f.categories ?? [];

const strFoodTitle = lang === 'fil' ? 'Mga Street Food Stall sa Baywalk' : lang === 'zh' ? '海湾步道街头美食摊' : 'Baywalk Street Food Stalls';
const strCategoryTitle = lang === 'fil' ? 'Uri ng Dining' : lang === 'zh' ? '餐饮类型' : 'Dining by Type';
const strDisclaimer = lang === 'fil' ? 'Bilang isang independiyenteng, non-commercial na gabay, lista namin ang pagkain ayon sa uri, hindi ayon sa tindahan. Ang presyo ay tinatayang at maaaring magbago.' : lang === 'zh' ? '作为独立非商业指南，我们按类型而非具体店铺列出餐饮。价格仅供参考，可能有变动。' : 'As an independent, non-commercial guide we list food by type, not by vendor. Prices are approximate and may vary.';
---

<section id="food" class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center mb-14">
    <p class="section-eyebrow mb-3">{lang === 'fil' ? 'Lasa ng Palawan' : lang === 'zh' ? '巴拉望的味道' : 'Taste of Palawan'}</p>
    <h2 class="font-display font-bold text-3xl sm:text-4xl text-navy mb-4">
      {f.title}
    </h2>
    <div class="w-20 h-1 bg-sunset rounded-full mx-auto mb-4"></div>
    <p class="text-navy/60 max-w-2xl mx-auto">
      {f.subtitle}
    </p>
  </div>

  <!-- Street Food -->
  <div class="mb-14">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 bg-sunset/10 rounded-xl flex items-center justify-center">
        <Icon name="food" size={20} class="text-sunset" />
      </div>
      <h3 class="font-display font-semibold text-xl text-navy">{strFoodTitle}</h3>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {streetFood.map(item => (
        <div class="bg-white rounded-xl p-3 shadow-sm border border-sand-warm/40 text-center">
          <p class="font-semibold text-navy text-xs mb-1">{item.item}</p>
          <p class="text-sunset font-bold text-xs">{item.price}</p>
          <p class="text-navy/40 text-[10px] mt-1">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Dining by type (neutral) -->
  <div>
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 bg-ocean/10 rounded-xl flex items-center justify-center">
        <Icon name="pin" size={20} class="text-ocean" />
      </div>
      <h3 class="font-display font-semibold text-xl text-navy">{strCategoryTitle}</h3>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
      {categories.map((c: any) => (
        <div class="bg-white rounded-2xl shadow-sm border border-sand-warm/40 p-5 hover:shadow-md transition-shadow flex flex-col">
          <h4 class="font-display font-semibold text-navy mb-2">{c[0]}</h4>
          <p class="text-navy/60 text-sm leading-relaxed flex-1">{c[2]}</p>
          <span class="bg-gold/10 text-gold text-xs font-semibold px-2 py-0.5 rounded-full mt-3 self-start">{c[1]}</span>
        </div>
      ))}
    </div>
  </div>

  {f.neutralNote && (
    <p class="text-center text-navy/55 text-xs mt-8 max-w-2xl mx-auto">{f.neutralNote}</p>
  )}
  <p class="text-center text-navy/40 text-xs mt-3">
    {strDisclaimer}
  </p>
</section>
