---
import { ui } from '../i18n/ui';
import { attraction, mapsUrl } from '../config';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = ui[lang] || ui['en'];
const f = t.footer;
---

<footer class="bg-navy text-white pt-16 sm:pt-20 pb-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <!-- Main Footer -->
    <div class="grid md:grid-cols-3 gap-10 mb-12">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2.5 mb-4">
          <svg width="32" height="32" viewBox="0 0 36 36" aria-hidden="true">
            <circle cx="18" cy="18" r="17" fill="#FDF6EC" stroke="#E8784A" stroke-width="1.5"/>
            <path d="M18 5.5c-1.3 3.2-3.2 5.2-3.2 8.5s2.4 6.2 3.2 9.5c.8-3.3 3.2-6.2 3.2-9.5s-1.9-5.3-3.2-8.5z" fill="#2D6A4F"/>
            <path d="M12.5 30c2.3-3.3 4.2-5.3 4.2-7.5s-2.4-5.2-3.3-7.5M23.5 30c-2.3-3.3-4.2-5.3-4.2-7.5s2.4-5.2 3.3-7.5" stroke="#E8784A" stroke-width="1.3" fill="none" stroke-linecap="round"/>
            <circle cx="18" cy="20.5" r="4.5" fill="#E8784A" opacity="0.3"/>
            <circle cx="18" cy="20.5" r="2.2" fill="#E8784A"/>
          </svg>
          <span class="font-display font-bold text-white">
            Baywalk Park<br />
            <span class="text-gold-light text-sm">Puerto Princesa</span>
          </span>
        </div>
        <p class="text-white/60 text-sm leading-relaxed mb-4">
          {f.tagline}
        </p>
        <div class="flex items-center gap-3 text-white/50 text-sm">
          <Icon name="pin" size={14} />
          <span>{attraction.plusCode}</span>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-display font-semibold text-gold-light mb-4">{f.nav?.home ? f.nav.home : 'Quick Links'}</h4>
        <ul class="space-y-2 text-sm">
          {[
            { href: '#about', label: t.header?.nav?.about || 'About' },
            { href: '#best-time', label: t.header?.nav?.bestTime || 'Best Time' },
            { href: '#tickets', label: t.header?.nav?.guide || 'Guide' },
            { href: '#parking', label: t.header?.nav?.facilities || 'Parking' },
            { href: '#gallery', label: f.nav?.gallery || 'Gallery' },
            { href: '#food', label: t.header?.nav?.guide || 'Food' },
            { href: '#transport', label: t.header?.nav?.transport || 'Transport' },
            { href: '#nearby', label: f.nav?.nearby || 'Nearby' },
            { href: '#faq', label: t.header?.nav?.faq || 'FAQ' },
          ].map(link => (
            <li>
              <a href={`/${lang}/${link.href}`} class="text-white/60 hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-display font-semibold text-gold-light mb-4">{f.nav?.contact || 'Info'}</h4>
        <ul class="space-y-3 text-sm text-white/60">
          <li class="flex items-start gap-2">
            <Icon name="clock" size={16} class="text-white/40 mt-0.5 shrink-0" />
            <span>{attraction.hours.display}</span>
          </li>
          <li class="flex items-start gap-2">
            <Icon name="pin" size={16} class="text-white/40 mt-0.5 shrink-0" />
            <span>{attraction.address}</span>
          </li>
          <li class="flex items-start gap-2">
            <Icon name="ticket" size={16} class="text-white/40 mt-0.5 shrink-0" />
            <span>{t.tickets?.free || 'Free'} · {attraction.priceRange}</span>
          </li>
          <li>
            <a
              href={mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-gold-light hover:text-gold transition-colors mt-2"
            >
              <Icon name="map" size={16} />
              {t.common.maps}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Legal Links -->
    <div class="border-t border-white/10 pt-6 mb-4 flex flex-wrap justify-center gap-4 text-xs text-white/40">
      <a href={`/${lang}/privacy-policy/`} class="hover:text-white transition-colors">{f.legal?.privacy || 'Privacy'}</a>
      <a href={`/${lang}/terms-of-service/`} class="hover:text-white transition-colors">{f.legal?.terms || 'Terms'}</a>
      <a href={`/${lang}/cookie-settings/`} class="hover:text-white transition-colors">{f.legal?.cookies || 'Cookies'}</a>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/10 pt-6 text-center">
      <p class="text-white/30 text-xs leading-relaxed">
        {f.copyright}
      </p>
    </div>
  </div>
</footer>
