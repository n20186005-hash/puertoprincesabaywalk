---
import { ui } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = ui[lang] || ui['en'];
const h = t.heritage;
const timeline = h.timeline ?? [];
const legend = h.legends ?? {};
const stories = legend.stories ?? [];
---

<section id="history" class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center mb-14">
    <p class="section-eyebrow mb-3">{h.eyebrow}</p>
    <h2 class="font-display font-bold text-3xl sm:text-4xl text-navy mb-4">
      {h.title}
    </h2>
    <div class="w-20 h-1 bg-sunset rounded-full mx-auto mb-4"></div>
    <p class="text-navy/60 max-w-2xl mx-auto">{h.subtitle}</p>
  </div>

  <!-- Timeline -->
  <ol class="relative border-l-2 border-sunset/30 pl-8 ml-2 sm:ml-4 mb-16 space-y-10">
    {timeline.map((item: any) => (
      <li class="relative">
        <span class="absolute -left-[41px] top-1 w-5 h-5 rounded-full bg-sunset ring-4 ring-cream"></span>
        <p class="text-xs font-semibold uppercase tracking-wide text-sunset mb-1">{item.era}</p>
        <h3 class="font-display font-semibold text-xl text-navy mb-2">{item.heading}</h3>
        <p class="text-navy/70 text-sm leading-relaxed max-w-2xl">{item.body}</p>
      </li>
    ))}
  </ol>

  <!-- Legends / Stories -->
  {legend && (
    <div class="bg-navy text-white rounded-3xl p-6 sm:p-10">
      <p class="section-eyebrow text-gold-light mb-2">{legend.title}</p>
      <h3 class="font-display font-bold text-2xl mb-3">{legend.title}</h3>
      <p class="text-white/70 max-w-2xl text-sm leading-relaxed mb-6">{legend.intro}</p>
      <div class="grid md:grid-cols-3 gap-4">
        {stories.map((st: any) => (
          <div class="bg-white/5 rounded-2xl p-5 border border-white/10">
            <div class="w-10 h-10 rounded-full bg-gold/20 flex items-center justify-center mb-3">
              <Icon name="leaf" size={20} class="text-gold-light" />
            </div>
            <h4 class="font-display font-semibold text-lg mb-2">{st.title}</h4>
            <p class="text-white/70 text-sm leading-relaxed">{st.body}</p>
          </div>
        ))}
      </div>
      {legend.note && (
        <p class="mt-6 text-white/40 text-xs leading-relaxed">{legend.note}</p>
      )}
    </div>
  )}
</section>
