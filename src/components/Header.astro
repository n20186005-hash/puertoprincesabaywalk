---
import Icon from './Icon.astro';

const navItems = [
  { href: '#about', label: 'About' },
  { href: '#best-time', label: 'Best Time' },
  { href: '#tickets', label: 'Tickets' },
  { href: '#parking', label: 'Parking' },
  { href: '#gallery', label: 'Gallery' },
  { href: '#food', label: 'Food' },
  { href: '#transport', label: 'Transport' },
  { href: '#nearby', label: 'Nearby' },
  { href: '#itinerary', label: 'Checklist' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="sticky top-0 z-50 bg-cream/95 backdrop-blur-md border-b border-sand-warm/50 shadow-sm" id="top">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="Puerto Princesa City Baywalk Park - Home">
        <svg width="36" height="36" viewBox="0 0 36 36" class="shrink-0" aria-hidden="true">
          <circle cx="18" cy="18" r="17" fill="#1B365D"/>
          <path d="M18 5c-1.5 3.5-3.5 5.5-3.5 9s2.5 6.5 3.5 10c1-3.5 3.5-6.5 3.5-10s-2-5.5-3.5-9z" fill="#2D6A4F"/>
          <path d="M12 31c2.5-3.5 4.5-5.5 4.5-8s-2.5-5.5-3.5-8M24 31c-2.5-3.5-4.5-5.5-4.5-8s2.5-5.5 3.5-8" stroke="#E8784A" stroke-width="1.5" fill="none"/>
          <path d="M4 20h28" stroke="#D4A03C" stroke-width="1.2"/>
          <circle cx="18" cy="20" r="5.5" fill="#FDF6EC"/>
          <circle cx="18" cy="20" r="2.8" fill="#E8784A"/>
        </svg>
        <span class="font-display font-bold text-sm sm:text-base leading-tight text-navy group-hover:text-ocean transition-colors">
          Baywalk Park<br class="sm:hidden" />
          <span class="hidden sm:inline">Puerto Princesa</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class="px-2.5 py-2 text-sm font-medium text-navy/80 hover:text-sunset transition-colors rounded-md hover:bg-sand-warm/30"
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-md text-navy hover:bg-sand-warm/50 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <Icon name="menu" size={24} />
      </button>
    </div>

    <!-- Mobile Nav -->
    <div id="mobile-menu" class="hidden lg:hidden pb-4 border-t border-sand-warm/30">
      <div class="flex flex-col pt-2">
        {navItems.map(item => (
          <a
            href={item.href}
            class="px-3 py-2.5 text-sm font-medium text-navy/80 hover:text-sunset hover:bg-sand-warm/20 rounded-md transition-colors"
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!open));
    });
    menu.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
