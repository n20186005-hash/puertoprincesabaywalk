---
import { ui } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = ui[lang] || ui['en'];
const ti = t.tides;

// Illustrative mixed semi-diurnal pattern for Puerto Princesa (Sulu Sea).
// Times/heights are representative EXAMPLES only — verify with a live tide table.
const tideWeek = [
  { h1: '05:10', hh1: 1.6, l1: '11:25', lh1: 0.5, h2: '17:45', hh2: 1.7, l2: '23:55', lh2: 0.4 },
  { h1: '06:00', hh1: 1.5, l1: '12:15', lh1: 0.6, h2: '18:35', hh2: 1.6, l2: '00:45', lh2: 0.5 },
  { h1: '06:50', hh1: 1.4, l1: '13:05', lh1: 0.7, h2: '19:25', hh2: 1.5, l2: '01:35', lh2: 0.6 },
  { h1: '07:40', hh1: 1.3, l1: '13:55', lh1: 0.8, h2: '20:15', hh2: 1.4, l2: '02:25', lh2: 0.7 },
  { h1: '08:30', hh1: 1.2, l1: '14:45', lh1: 0.9, h2: '21:05', hh2: 1.3, l2: '03:15', lh2: 0.8 },
  { h1: '09:20', hh1: 1.2, l1: '15:35', lh1: 1.0, h2: '21:55', hh2: 1.3, l2: '04:05', lh2: 0.9 },
  { h1: '10:10', hh1: 1.3, l1: '16:25', lh1: 1.0, h2: '22:45', hh2: 1.4, l2: '04:55', lh2: 0.9 },
];
---

<section id="tides" class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center mb-14">
    <p class="section-eyebrow mb-3">{ti.eyebrow}</p>
    <h2 class="font-display font-bold text-3xl sm:text-4xl text-navy mb-4">
      {ti.title}
    </h2>
    <div class="w-20 h-1 bg-sunset rounded-full mx-auto mb-4"></div>
    <p class="text-navy/60 max-w-2xl mx-auto">{ti.subtitle}</p>
  </div>

  <!-- Intro -->
  <div class="bg-ocean/5 border border-ocean/10 rounded-2xl p-6 sm:p-8 mb-12 flex items-start gap-4">
    <div class="w-12 h-12 rounded-full bg-ocean/10 flex items-center justify-center shrink-0">
      <Icon name="water" size={24} class="text-ocean" />
    </div>
    <p class="text-navy/70 leading-relaxed text-sm sm:text-base">{ti.intro}</p>
  </div>

  <!-- Tide Table -->
  <div class="mb-4 flex items-center gap-2">
    <Icon name="clock" size={20} class="text-sunset" />
    <h3 class="font-display font-semibold text-xl text-navy">{ti.patternTitle}</h3>
  </div>

  <div class="overflow-x-auto rounded-2xl border border-sand-warm/50 shadow-sm mb-3">
    <table class="w-full text-sm border-collapse min-w-[640px]">
      <thead>
        <tr class="bg-navy text-white">
          <th class="text-left font-semibold px-4 py-3">{ti.days[0] && ''}</th>
          <th class="px-3 py-3 text-center font-semibold" colspan="2">
            <span class="inline-flex items-center gap-1.5"><Icon name="water" size={14} class="text-gold-light" />{ti.high}</span>
          </th>
          <th class="px-3 py-3 text-center font-semibold" colspan="2">
            <span class="inline-flex items-center gap-1.5 opacity-80">{ti.low}</span>
          </th>
          <th class="px-3 py-3 text-center font-semibold" colspan="2">
            <span class="inline-flex items-center gap-1.5"><Icon name="water" size={14} class="text-gold-light" />{ti.high}</span>
          </th>
          <th class="px-3 py-3 text-center font-semibold" colspan="2">
            <span class="inline-flex items-center gap-1.5 opacity-80">{ti.low}</span>
          </th>
        </tr>
        <tr class="bg-navy/90 text-white/70 text-xs">
          <th class="text-left font-medium px-4 py-2">{lang === 'zh' ? '星期' : lang === 'fil' ? 'Araw' : 'Day'}</th>
          <th class="px-3 py-2 font-medium">{ti.time}</th>
          <th class="px-3 py-2 font-medium">{ti.height}</th>
          <th class="px-3 py-2 font-medium">{ti.time}</th>
          <th class="px-3 py-2 font-medium">{ti.height}</th>
          <th class="px-3 py-2 font-medium">{ti.time}</th>
          <th class="px-3 py-2 font-medium">{ti.height}</th>
          <th class="px-3 py-2 font-medium">{ti.time}</th>
          <th class="px-3 py-2 font-medium">{ti.height}</th>
        </tr>
      </thead>
      <tbody>
        {tideWeek.map((d, i) => (
          <tr class:list={['border-t border-sand-warm/40', i % 2 === 1 ? 'bg-sand-warm/20' : 'bg-white']}>
            <td class="px-4 py-3 font-display font-semibold text-navy">{ti.days[i]}</td>
            <td class="px-3 py-3 text-center text-navy font-medium">{d.h1}</td>
            <td class="px-3 py-3 text-center text-ocean font-semibold">{d.hh1.toFixed(1)}</td>
            <td class="px-3 py-3 text-center text-navy/70">{d.l1}</td>
            <td class="px-3 py-3 text-center text-gold font-semibold">{d.lh1.toFixed(1)}</td>
            <td class="px-3 py-3 text-center text-navy font-medium">{d.h2}</td>
            <td class="px-3 py-3 text-center text-ocean font-semibold">{d.hh2.toFixed(1)}</td>
            <td class="px-3 py-3 text-center text-navy/70">{d.l2}</td>
            <td class="px-3 py-3 text-center text-gold font-semibold">{d.lh2.toFixed(1)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="text-navy/40 text-xs mb-12">{ti.weekNote}</p>

  <!-- Tips -->
  <div>
    <div class="flex items-center gap-2 mb-6">
      <Icon name="info" size={20} class="text-palm" />
      <h3 class="font-display font-semibold text-xl text-navy">{ti.tipsTitle}</h3>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
      {ti.tips?.map((tip: string) => (
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-sand-warm/40 flex items-start gap-3">
          <span class="w-7 h-7 rounded-full bg-palm/10 text-palm flex items-center justify-center shrink-0 mt-0.5">
            <Icon name="check" size={16} />
          </span>
          <p class="text-navy/70 text-sm leading-relaxed">{tip}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Disclaimer -->
  <p class="text-center text-navy/40 text-xs mt-10 max-w-3xl mx-auto">
    {ti.disclaimer}
  </p>
</section>
