# ─── Dependencies (never deploy source) ──────────────────────────────
node_modules/

# ─── Build output ─────────────────────────────────────────────────────
# `dist/` is the folder uploaded to Cloudflare Workers (static assets).
# It is generated by `pnpm build`; do not commit or upload it as source.
dist/
.astro/

# ─── Environment & secrets ───────────────────────────────────────────
.env
.env.*
.dev.vars
*.local

# ─── Cloudflare local state ──────────────────────────────────────────
.wrangler/

# ─── Logs & debug ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─── Editor / OS / caches ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
.cache/

# ─── Misc ────────────────────────────────────────────────────────────
*.tmp
.turbo/
.vercel
